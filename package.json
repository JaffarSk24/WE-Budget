{
  "name": "we-budget",
  "private": true,
  "version": "1.0.2",
  "description": "Desktop budgeting app built around a payment calendar, with envelopes, money set aside and sync through Google Drive.",
  "author": {
    "name": "White Eagles & Co. s.r.o.",
    "url": "https://whiteeagles.sk/"
  },
  "license": "MIT",
  "homepage": "https://github.com/JaffarSk24/WE-Budget",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaffarSk24/WE-Budget.git"
  },
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:prod": "npm run build && cross-env NODE_ENV=production electron .",
    "electron:pack": "npm run build && electron-builder --dir --publish never",
    "electron:dist": "npm run build && electron-builder --mac --publish never",
    "electron:dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "chart.js": "^4.5.1",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^10.12.0",
    "lucide": "^1.52.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.whiteeagles.webudget",
    "productName": "WE Budget",
    "directories": {
      "output": "release.nosync"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "main/**/*.cjs",
      "oauth-credentials.json",
      "icon.png"
    ],
    "afterPack": "./scripts/adhoc-sign.cjs",
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "packElevateHelper": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WE Budget"
    },
    "asarUnpack": [
      "icon.png"
    ],
    "artifactName": "WE-Budget-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "JaffarSk24",
        "repo": "WE-Budget",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright © 2026 White Eagles & Co. s.r.o."
  }
}
